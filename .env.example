# Paste your Neon connection string here. Never commit the real value.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
PORT=3001
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
NODE_ENV=development

# Zoho Mail India data center (confirm the exact host in Zoho Server Configuration Details)
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=notifications@your-domain.com
SMTP_PASSWORD=your-zoho-app-password
MAIL_FROM=DSS Flow <notifications@your-domain.com>
APP_URL=http://localhost:3001
APP_VERSION=1.0.0
APP_RELEASE_TITLE=DSS Flow update
APP_RELEASE_NOTES=Performance improvements and new collaboration features.
REDIS_URL=

# Optional TURN relay for WebRTC calls outside simple networks
# Optional organization-controlled WebRTC connectivity servers. Leave blank for
# direct peer-to-peer calls on reachable networks.
STUN_URL=
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
