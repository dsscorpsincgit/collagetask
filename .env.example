# Paste your Neon connection string here. Never commit the real value.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
PORT=3001
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
NODE_ENV=development

# Zoho Mail India data center (confirm the exact host in Zoho Server Configuration Details)
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=notifications@your-domain.com
SMTP_PASSWORD=your-zoho-app-password
MAIL_FROM=DSS Flow <notifications@your-domain.com>
APP_URL=http://localhost:3001
# Local-development fallback only. Vercel deployments automatically use their
# unique VERCEL_DEPLOYMENT_ID, so this does not need to be changed per release.
APP_VERSION=1.0.0
# Optional reusable defaults. On Vercel, the Git commit message is used as the
# release notes when system environment variables are enabled.
APP_RELEASE_TITLE=DSS Flow update
APP_RELEASE_NOTES=Performance improvements and new collaboration features.
REDIS_URL=

# Required for Android/desktop notifications while the PWA is closed.
# Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=BLiPVwZtXtn_f9k_k-B3ErkSAO-Dryh2FjYJLZw7y2YWXP7DrA2ybf-tXPE-1R1wBEe_VVDV_BBK84wSiYIak40
VAPID_PRIVATE_KEY=t9Mr197pQdR6z98bP80EKepmYY1Fj1iVb0Xj50qXOsg
VAPID_SUBJECT=mailto:notifications@your-domain.com

# Optional organization-controlled WebRTC connectivity servers. When STUN_URL
# is blank, DSS Flow uses Google's public STUN service. Configure TURN for
# dependable calls across restrictive corporate, mobile, or symmetric NATs.
STUN_URL=
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
